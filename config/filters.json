    "abs:\"medical\" AND abs:\"reinforcement learning\" AND abs:\"reasoning\"",
    "abs:\"medical\" AND abs:\"test-time\"",
    "abs:\"radiology\" AND abs:\"reasoning\"",
    "abs:\"pathology\" AND abs:\"reasoning\"",
    "abs:\"medical\" AND abs:\"vision-language\" AND abs:\"reasoning\"",
    "abs:\"clinical\" AND abs:\"large language model\" AND abs:\"reasoning\"",
    "abs:\"medical\" AND abs:\"benchmark\" AND abs:\"reasoning\""
  ],

  "reasoning_terms_comment": "必须命中一个，否则只是普通医学 LLM 应用，不属于本仓库范围。",
  "reasoning_terms": [
